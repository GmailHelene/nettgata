# Cloudflare leser denne fila. Filene under _next/static har innholdet i navnet og endrer seg aldri.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Malbilder og skrift har faste navn, så de får 30 dager og ikke immutable.
/maler/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=2592000
