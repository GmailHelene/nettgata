# Lokalt: la DATABASE_URL være tom, da brukes PGlite i .data/
# Produksjon: Neon i Frankfurt (eu-central-1)
DATABASE_URL=

# Minst 32 tegn. Lag med: openssl rand -base64 32
SESSION_SECRET=

# Vertsnavn der studioet og salgssiden ligger (kommaseparert)
PLATFORM_HOSTS=localhost:3000,app.helene.cloud

# Gratis underdomene for alle nettsteder: <slug>.<SITES_ROOT_DOMAIN>
SITES_ROOT_DOMAIN=localhost:3000

# Brukes av seed-skriptet for å lage første admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
