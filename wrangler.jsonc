{
  "$schema": "node_modules/wrangler/config-schema.json",
  // custom-worker.ts pakker inn OpenNext sin Worker og legger til bakgrunnsjobben for domener.
  "main": "custom-worker.ts",
  "name": "plattformen",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "plattformen" }],
  "observability": { "enabled": true },
  // Bildelager (R2, Vest-Europa). Leses i lib/storage.ts som env.MEDIA.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "plattformen-media" }],
  // Gratis underdomener per kunde krever eget domene på Cloudflare; til da vises nettstedene på /vis/<slug>.
  "vars": {
    "PLATFORM_HOSTS": "plattformen.helene721.workers.dev",
    "SITES_ROOT_DOMAIN": "",
    // Domenekobling (Cloudflare for SaaS). Tomme til plattformen har eget domene; se docs/DOMENEKOBLING.md.
    // Kundene peker til <token>.<CUSTOM_DOMAIN_TARGET>. CF_API_TOKEN settes som hemmelighet, aldri her.
    "CF_ZONE_ID": "",
    "CUSTOM_DOMAIN_TARGET": "",
    // Plattformens ekstra adresser som sender videre til hovedadressen (custom-worker.ts). Tomme til nettgata.no er aktiv.
    "PLATFORM_ALIASES": "",
    "PLATFORM_CANONICAL_HOST": ""
  },
  // Sjekker ventende kundedomener hvert tiende minutt (custom-worker.ts -> /api/cron/domener).
  "triggers": { "crons": ["*/10 * * * *"] }
  // Hemmeligheter (DATABASE_URL, SESSION_SECRET) settes med scripts/oppsett-produksjon.ps1, aldri her.
}
