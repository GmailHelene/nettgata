{
  "$schema": "node_modules/wrangler/config-schema.json",
  // custom-worker.ts pakker inn OpenNext sin Worker og legger til bakgrunnsjobben for domener.
  "main": "custom-worker.ts",
  "name": "plattformen",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "plattformen" }],
  "observability": { "enabled": true },
  // Bildelager (R2, Vest-Europa). Leses i lib/storage.ts som env.MEDIA.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "plattformen-media" }],
  // nettgata.no: alt i sonen går til Workeren, også kundenes egne domener (Cloudflare for SaaS sender dem hit).
  // nettgata.com: bare videresending til nettgata.no (PLATFORM_ALIASES).
  "routes": [
    { "pattern": "*/*", "zone_name": "nettgata.no" },
    { "pattern": "*nettgata.com/*", "zone_name": "nettgata.com" }
  ],
  // Med ruter slår wrangler av workers.dev-adressen hvis den ikke er satt. Den beholdes som reserveinngang
  // til studioet hvis nettgata.no skulle få problemer (står også i PLATFORM_HOSTS).
  "workers_dev": true,
  // Egne adresser per opplastet versjon trengs ikke, og gamle versjoner skal ikke kunne nås.
  "preview_urls": false,
  // Gratis underdomener per kunde: <navn>.nettgata.no. Nettstedene vises også på /vis/<slug> på plattformens adresse.
  "vars": {
    "PLATFORM_HOSTS": "nettgata.no,plattformen.helene721.workers.dev",
    "SITES_ROOT_DOMAIN": "nettgata.no",
    // Domenekobling (Cloudflare for SaaS), se docs/DOMENEKOBLING.md. Sone-ID-en er ikke hemmelig.
    // Kundene peker til <token>.kunder.nettgata.no. CF_API_TOKEN er en hemmelighet på Workeren, aldri her.
    "CF_ZONE_ID": "e54f1f69acee889fc7001cbbae74d6c2",
    "CUSTOM_DOMAIN_TARGET": "kunder.nettgata.no",
    // Plattformens ekstra adresser som sender videre til hovedadressen (custom-worker.ts).
    "PLATFORM_ALIASES": "nettgata.com,www.nettgata.com,www.nettgata.no",
    "PLATFORM_CANONICAL_HOST": "nettgata.no",
    // Avsenderadressen for e-post (for eksempel ordre@nettgata.no). BREVO_API_KEY settes som hemmelighet.
    // Uten begge lagres e-postene bare i loggen. Se docs/EPOST.md.
    "EMAIL_FROM": "ordre@nettgata.no"
  },
  // Hvert tiende minutt: ventende kundedomener og betalinger. Hver natt: sikkerhetskopi (se custom-worker.ts).
  "triggers": { "crons": ["*/10 * * * *", "30 1 * * *"] }
  // Hemmeligheter (DATABASE_URL, SESSION_SECRET) settes med scripts/oppsett-produksjon.ps1, aldri her.
}
